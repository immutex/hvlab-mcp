# EditorConfig — keeps indentation and line endings consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
